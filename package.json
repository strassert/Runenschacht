    "@types/three": "^0.170.0",
    "eslint": "^9.39.5",
    "globals": "^15.15.0",
    "prettier": "^3.9.9",
    "typescript": "~5.6",
    "typescript-eslint": "^8.71.0",
    "vite": "^6.4.3",
    "vitest": "^2.1.9"
  }
}
